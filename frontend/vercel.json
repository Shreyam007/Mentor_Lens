{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mentorlens-api.onrender.com/api/:path*"
    },
    {
      "source": "/webhooks/:path*",
      "destination": "https://mentorlens-api.onrender.com/webhooks/:path*"
    },
    {
      "source": "/health",
      "destination": "https://mentorlens-api.onrender.com/health"
    },
    {
      "source": "/ready",
      "destination": "https://mentorlens-api.onrender.com/ready"
    },
    {
      "source": "/metrics",
      "destination": "https://mentorlens-api.onrender.com/metrics"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
