# MentorLens Environment Configuration Example

# Server Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars-long
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://mentorlens:mentorlens@postgres:5432/mentorlens
# Local fallback when testing without docker:
# DATABASE_URL=sqlite+aiosqlite:///./mentorlens.db

# Redis & ARQ Worker
REDIS_URL=redis://redis:6379/0

# ChromaDB Vector Store
CHROMA_HOST=chroma
CHROMA_PORT=8000
# Or local Chroma path:
CHROMA_PERSIST_DIRECTORY=./chroma_data

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=development_webhook_secret_12345
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM Providers
DEFAULT_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MONTHLY_COST_CAP_USD=50.0

# Embedding Provider (sentence-transformers | openai)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
